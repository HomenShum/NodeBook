NEXT_PUBLIC_IS_AUTH_ENABLED=true
NEXT_PUBLIC_PERSISTENCE_ENABLED=true
NEXT_PUBLIC_USE_MOCK_USER_IF_AUTH_DISABLED=false
NEXT_PUBLIC_ENV=production
